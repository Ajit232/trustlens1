# Copy this file to .env for local development. Never commit the real .env.
# Nothing below is a real secret.

PRODUCT_NAME=LinkAegis

# --- Development (default) --------------------------------------------
# Leave DJANGO_ENVIRONMENT unset or "development" for local work.
# DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=replace-this-with-a-random-value-for-local-dev
# DJANGO_DEBUG defaults to True in development, False in production.
# DJANGO_ALLOWED_HOSTS defaults to localhost,127.0.0.1 in development.
# Leave DATABASE_URL unset in development to use local SQLite automatically.

# The extension's dev origin — the ONE origin CORS allows. Get this from
# chrome://extensions after loading the extension unpacked (it's stable
# per unpacked-load path, but you must set it yourself; there's no default).
EXTENSION_DEV_ORIGIN=chrome-extension://replace-with-your-loaded-extension-id

# Rate limits (DRF throttle-rate syntax, e.g. "30/min", "1000/day")
ANON_RATE_LIMIT=60/min
CHECK_URL_RATE_LIMIT=30/min

# Seconds the API tells the extension to cache a verdict for.
CHECK_URL_DEFAULT_CACHE_TTL_SECONDS=300

SCANNER_LOG_LEVEL=INFO

# --- Production example (uncomment / set as real env vars, not in git) --
# DJANGO_ENVIRONMENT=production
# DJANGO_SECRET_KEY=<a long random value from `python -c "import secrets; print(secrets.token_urlsafe(50))"`>
# DJANGO_ALLOWED_HOSTS=api.linkaegis.example
# DATABASE_URL=postgres://user:password@host:5432/linkaegis
# EXTENSION_DEV_ORIGIN=chrome-extension://<published-extension-id>
# CHECK_URL_RATE_LIMIT=30/min
